{
    "name": "better-civ",
    "version": "2.5.1",
    "description": "Une application web moderne pour explorer et comparer les civilisations de Civilization V",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.22.0",
    "keywords": [
        "civilization",
        "civ5",
        "vue",
        "vite",
        "tailwindcss",
        "primevue",
        "gaming",
        "strategy"
    ],
    "author": "Neuraaak",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/neuraaak/Better-Civ.git"
    },
    "homepage": "https://github.com/neuraaak/Better-Civ#readme",
    "bugs": {
        "url": "https://github.com/neuraaak/Better-Civ/issues"
    },
    "engines": {
        "node": "24.x",
        "pnpm": ">=11.22.0"
    },
    "scripts": {
        "dev": "vite --config config/vite.config.js",
        "build": "vite build --config config/vite.config.js",
        "preview": "vite preview --config config/vite.config.js",
        "lint": "eslint src tests config --config config/eslint.config.js",
        "lint:fix": "pnpm lint --fix",
        "type-check": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tests/tsconfig.json",
        "clean": "rimraf dist _temp",
        "clean:all": "rimraf dist _temp node_modules",
        "deps:check": "pnpm outdated",
        "deps:update": "pnpm update --interactive --latest",
        "deps:update-all": "pnpm update --latest",
        "deps:update-prod": "pnpm update --latest --prod",
        "deps:update-dev": "pnpm update --latest --dev",
        "deps:audit": "pnpm audit",
        "deps:fix": "pnpm audit --fix",
        "validate:quick": "pnpm lint && pnpm type-check",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,vue,json,css,md,html}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,vue,json,css,md,html}\"",
        "test": "vitest --config config/vitest.config.js",
        "test:ui": "vitest --ui --config config/vitest.config.js",
        "test:run": "vitest run --config config/vitest.config.js",
        "test:coverage": "vitest run --coverage --config config/vitest.config.js",
        "test:watch": "vitest --watch --config config/vitest.config.js",
        "db:build:civ5": "tsx .scripts/db/civ5/import.ts",
        "db:images:civ5": "tsx .scripts/db/civ5/images.ts",
        "type-check:scripts": "tsc --noEmit -p .scripts/tsconfig.json",
        "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test:run && pnpm build",
        "prepare": "husky"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource/cinzel": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fontsource/unifrakturmaguntia": "^5.3.0",
        "@vueuse/core": "^13.6.0",
        "pinia": "^4.1.0",
        "sql.js": "^1.15.1",
        "vue": "^3.5.18",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^24.1.0",
        "@types/sql.js": "^1.4.11",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vitest/coverage-v8": "3.2.4",
        "@vitest/ui": "^3.2.4",
        "@vue/test-utils": "^2.4.6",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.3",
        "eslint-plugin-vue": "^10.3.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.0.5",
        "postcss": "^8.5.30",
        "prettier": "^3.6.2",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.20.6",
        "typescript": "^5.8.3",
        "vite": "^8.3.5",
        "vitest": "^3.2.4",
        "vue-eslint-parser": "^10.2.0",
        "vue-tsc": "^3.3.13"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,vue}": [
            "prettier --write",
            "eslint --fix --config config/eslint.config.js"
        ],
        "*.{json,md,css,html}": "prettier --write"
    }
}
